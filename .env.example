NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_SENDER_EMAIL=

BREVO_HOST=
BREVO_PORT=
BREVO_USERNAME=
BREVO_PASSWORD=
BREVO_SENDER_EMAIL=

# Copy needed entries into ignored .env.local; never commit credentials.

# Development seed only. Leave disabled until the development target is approved.
ENABLE_DEV_ACCOUNT_SEED=false
SEED_EXPECTED_PROJECT_REF=
# Direct db.<ref>.supabase.co or Supavisor postgres.<ref> connection to /postgres.
# URL-encode credentials. No query parameters; TLS certificate verification is enforced.
SEED_DATABASE_URL=
# If needed, set NODE_EXTRA_CA_CERTS to the project's trusted CA PEM file path.
# Nine distinct synthetic-account passwords, each 12–72 UTF-8 bytes; use different values.
SEED_ADMIN_PASSWORD=
SEED_EXECUTIVE_PASSWORD=
SEED_OPERATIONS_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_REPRESENTATIVE_PASSWORD=
SEED_ACADEMIC_INSTRUCTOR_PASSWORD=
SEED_ACADEMIC_COORDINATOR_PASSWORD=
SEED_CLINICAL_INSTRUCTOR_PASSWORD=
SEED_RLE_COORDINATOR_PASSWORD=

# Explicit academic year, agreed term text and ISO dates (YYYY-MM-DD).
# Keep these unchanged for reruns. No approved term allowlist exists in migrations.
SEED_SEMESTER_YEAR=
SEED_SEMESTER_TERM=
SEED_SEMESTER_STARTS_ON=
SEED_SEMESTER_ENDS_ON=
# Explicit true/false. true refuses to replace another current semester.
SEED_SEMESTER_IS_CURRENT=
